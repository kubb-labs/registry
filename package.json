{
  "name": "@kubb/registry",
  "version": "0.0.0",
  "description": "The Kubb extension registry: reviewed, pinned plugins, adapters, and parsers, published as static JSON for kubb.dev, Kubb Studio, and the Kubb CLI.",
  "keywords": [
    "extensions",
    "kubb",
    "plugins",
    "registry"
  ],
  "homepage": "https://kubb.dev/extensions",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/registry.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.json",
  "exports": {
    ".": "./dist/index.json",
    "./schemas/*": "./dist/schemas/*",
    "./*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "approve": "node scripts/approve.ts",
    "build": "node scripts/build.ts",
    "bump": "node scripts/bump.ts",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "lint": "oxlint -c oxlint.config.ts scripts",
    "submit": "node scripts/submit.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
